# Required in all environments except automated tests. Do not reuse values between fields.
# AUTH_JWT_SECRET and ENCRYPTION_SECRET: at least 32 characters; `openssl rand -base64 48` is suitable.
# ADMIN_PASSWORD: at least 14 characters; use a unique random password or strong passphrase.
AUTH_JWT_SECRET=
ADMIN_PASSWORD=
ENCRYPTION_SECRET=

# Optional
WIKI_STORE_FILE_PATH=./data/wiki-store.json
WIKI_SSL_STORAGE_DIR=./data/ssl
WIKI_MARKDOWN_CACHE_DIR=./data/markdown-cache
WIKI_DOCS_SNAPSHOT_DIR=./data/docs-cache/snapshots
WIKI_TRANSLATION_CACHE_DIR=./data/translation-cache
WIKI_ANALYTICS_DB_PATH=./data/wiki-analytics.sqlite
# Public docs read admission limits are enforced independently in each app process.
PUBLIC_DOCS_CLIENT_MAX_REQUESTS=180
PUBLIC_DOCS_GLOBAL_MAX_REQUESTS=5000
PUBLIC_DOCS_RATE_WINDOW_SECONDS=60
PUBLIC_DOCS_CLIENT_MAX_CONCURRENCY=12
PUBLIC_DOCS_GLOBAL_MAX_CONCURRENCY=128
# Public page-view ingestion limits are enforced independently in each app process.
VISITOR_ANALYTICS_CLIENT_MAX_REQUESTS=60
VISITOR_ANALYTICS_GLOBAL_MAX_REQUESTS=1200
VISITOR_ANALYTICS_RATE_WINDOW_SECONDS=60
VISITOR_ANALYTICS_CLIENT_MAX_CONCURRENCY=4
VISITOR_ANALYTICS_GLOBAL_MAX_CONCURRENCY=32
VISITOR_ANALYTICS_QUEUE_CAPACITY=1000
# Failed SQLite writes use bounded exponential retry delays and are attempted at most three times.
VISITOR_ANALYTICS_RETRY_BASE_MS=1000
VISITOR_ANALYTICS_RETRY_MAX_MS=30000
# Initial in-memory docs cache TTL; the persisted admin setting takes precedence after setup.
DOCS_CACHE_TTL_MS=3600000
# Listen on all local interfaces by default.
HOST=0.0.0.0
# Default HTTP listen port. Set to 80 for direct Let's Encrypt HTTP-01.
# Binding low ports (80/443) may require root, CAP_NET_BIND_SERVICE, or a reverse proxy.
HTTP_PORT=3000
# Default HTTPS listen port for automatic certificates.
HTTPS_PORT=443
# Automatic certificate renewal checks and threshold.
SSL_CHECK_INTERVAL_MS=21600000
SSL_RENEW_BEFORE_MS=2592000000
# Debounced store watcher refresh for near-immediate domain/SSL config apply after settings changes.
SSL_STORE_WATCH_DEBOUNCE_MS=1500
# Exponential retry backoff for failed Let's Encrypt issuance attempts.
SSL_ISSUE_RETRY_BASE_MS=900000
SSL_ISSUE_RETRY_MAX_MS=86400000
# Grace period for production server shutdown.
SERVER_CLOSE_GRACE_MS=5000
# Private persisted SSL status snapshot used by the authenticated admin status route.
SSL_STATUS_FILE_PATH=./data/ssl/runtime-ssl-status.json
# Optional external SSL health endpoint. It is disabled (404) unless a bearer token is set.
# Authenticated responses are deliberately sanitized; use a long, randomly generated token.
SSL_STATUS_ENDPOINT_PATH=/.well-known/vicky/ssl-status
SSL_STATUS_BEARER_TOKEN=
# Use Let's Encrypt staging CA for dry runs to avoid production rate limits.
LETS_ENCRYPT_STAGING=false
ADMIN_SESSION_MAX_AGE_SECONDS=43200
AUTH_LOGIN_MAX_FAILURES=8
AUTH_LOGIN_WINDOW_SECONDS=600
AUTH_LOGIN_BLOCK_SECONDS=10800
# Accept one proxy-overwritten client IP only when the authenticated socket peer exactly
# matches AUTH_TRUSTED_PROXY_IPS. The Vicky port must still be isolated to that ingress.
AUTH_TRUST_PROXY_HEADERS=false
# Comma-separated exact proxy socket addresses; CIDR ranges and hostnames are unsupported.
# IPv4-mapped IPv6 socket addresses are normalized to IPv4 before matching.
AUTH_TRUSTED_PROXY_IPS=
# Trust exactly one x-forwarded-host + x-forwarded-proto pair only behind an ingress that
# removes client-supplied values, overwrites both headers, and is the sole path to Vicky.
VICKY_TRUST_PROXY_ORIGIN_HEADERS=false
# Optional for plain `next start` without the included server or a trusted proxy. Set to
# exactly http or https when the public/direct protocol cannot be inferred from localhost.
VICKY_DIRECT_REQUEST_PROTOCOL=
# Optional durable login-rate-limit store path (used for cross-restart persistence).
AUTH_LOGIN_STORE_FILE_PATH=./data/login-rate-limit.json
